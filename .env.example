# Environment Variable Configuration for Matrix Factory Twin

# HMAC Secret Key for Authenticated Telemetry WebSockets (:8080)
TELEMETRY_HMAC_SECRET=phase4_monte_carlo_secure_key_9912

# gRPC Security Configuration (set to true for TLS/mTLS)
GRPC_SECURE_MODE=false
GRPC_CERT_DIR=certs

# Numba Multi-Threading Pinning (default: derived per CPU topology)
NUMBA_NUM_THREADS=1

# Phase 4 Single-JVM Monte Carlo Execution Parameters
RUN_COUNT=15
RUN_START_ID=0
BASE_PORT=50051
JVM_CORES=0,1
